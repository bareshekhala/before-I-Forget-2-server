// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
// note: these two commands may needed here: 
//1- npx prisma migrate dev --name add-models or update-models -> new tabales in the PostgreSQL 
//2-npx prisma generate

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String?
  createdAt DateTime   @default(now())
  favBooks  favBook[]
  favMovies favMovie[]
  favSongs  favSong[]
  myMinds   myMind[]
}

model Book {
  id          String  @id @default(uuid())
  title        String
  author      String?
  description String?
  image       String?
  category    String
  pageCount   Int?
  moods Mood[]
}

model Movie {
  id          String  @id @default(uuid())
  title       String
  category    String
  overview    String?
  poster_path String?
  moods Mood[]
}

model Song {
  id               String  @id @default(uuid())
  title            String
  singerOrComposer String
  image            String?
  url              String?
  moods Mood[]
}

model myMind {
  id          String    @id @default(uuid())
  title       String
  image       String?
  description String?
  category    String
  date        DateTime?
  userId      String
  //onDelete: Cascade -> if a user gets deleted all the records of it will be deleted too
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  moods Mood[]
}

model favBook {
  id          String  @id @default(uuid())
  name        String
  author      String?
  description String?
  image       String?
  category    String
  pageCount   Int?
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  moods Mood[]
  @@index([userId])
}

model favMovie {
  id          String  @id @default(uuid())
  title       String
  category    String
  overview    String?
  poster_path String?
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  moods Mood[]
  @@index([userId])
}

model favSong {
  id               String  @id @default(uuid())
  title            String
  singerOrComposer String
  image            String?
  url              String?
  userId           String
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  moods Mood[]
  @@index([userId])
}

model Mood {
  id   String @id @default(uuid())
  name String @unique
   books     Book[]
  movies    Movie[]
  songs     Song[]
  myMinds   myMind[]
  favBooks  favBook[]
  favMovies favMovie[]
  favSongs  favSong[]
}
